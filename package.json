{
  "name": "tickets-gasolina",
  "version": "1.0.0",
  "private": true,
  "description": "Gestion integral de tickets digitales e inventario de combustible",
  "type": "module",
  "scripts": {
    "build": "node --check src/server.js && node --check public/app.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-isolation=none",
    "check": "node --check src/server.js && node --check public/app.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4"
  }
}
